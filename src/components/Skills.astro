---
import SubtitleSection from "@astro/SubtitleSection.astro";
import { Badge } from "@atoms/badge";
---

<SubtitleSection title="Habilidades" />

<section class="flex flex-col justify-center gap-2 p-2">
  <div class="mx-auto">
    <small>Lenguajes y por aprender:</small>
    <Badge variant="secondary">JavaScript</Badge>
    <Badge variant="secondary">Python</Badge>
    <Badge variant="secondary">SQL</Badge>
    <Badge variant="secondary">CSS</Badge>
  </div>
  <div class="mx-auto">
    <small>Quiero aprender estos Framework's/Librerias:</small>
    <Badge variant="secondary">React</Badge>
    <Badge variant="secondary">Astro</Badge>
    <Badge variant="secondary">Next.js</Badge>
  </div>
</section>
